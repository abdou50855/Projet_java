<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.abderrahmane.gamecollection.controllers.AuthController">

    <center>
        <VBox spacing="15" alignment="CENTER">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <Label text="Créer un compte" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <TextField fx:id="signupUsernameField" promptText="Nom d'utilisateur" prefWidth="250"/>
            <PasswordField fx:id="signupPasswordField" promptText="Mot de passe" prefWidth="250"/>

            <Button text="S'inscrire" fx:id="signupBtn" prefWidth="250"/>
            <Button text="Déjà un compte ? Se connecter" fx:id="goToLoginBtn" prefWidth="250"/>
        </VBox>
    </center>
</BorderPane>
